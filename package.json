{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src scripts tests *.ts *.mts *.mjs"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "minisearch": "^7.2.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
